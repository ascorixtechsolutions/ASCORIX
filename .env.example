# Server Configuration
PORT=3000
NODE_ENV=development

# Database Provider Configuration ('supabase', 'mongodb', or 'local')
DB_PROVIDER=local

# Security & Authentication Secrets
JWT_SECRET=

# Supabase Credentials (Required if DB_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# MongoDB Connection String (Required if DB_PROVIDER=mongodb)
MONGODB_URI=

# Nodemailer / Email Service Credentials
EMAIL_USER=
EMAIL_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
OWNER_EMAIL=

# Notification Services (Optional)
OWNER_WHATSAPP_NUMBER=
CALLMEBOT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=
